RewriteEngine On

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Redirect non-www to www (canonical host)
RewriteCond %{HTTP_HOST} ^shaytechsolutions\.com$ [NC]
RewriteRule ^(.*)$ https://www.shaytechsolutions.com/$1 [R=301,L]

# ─── Security headers ───────────────────────────────────────────
<IfModule mod_headers.c>
    # Force HTTPS for one year, include subdomains, allow HSTS preload
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Stop MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Block being iframed (clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Don't leak full URLs as referrer to third parties
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Lock down browser features we don't use
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

    # Cross-origin policies
    Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
